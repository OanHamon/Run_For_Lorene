# Mise en production (OVH) : APP_ENV=production, APP_DEBUG=false, APP_URL en https://,
# SESSION_SECURE_COOKIE=true, LOG_LEVEL=warning, clés Stripe live, MAIL_* Brevo, TRUSTED_PROXIES
# si un proxy précède le site. Puis : un worker de file (php artisan queue:work) et le cron du
# planificateur (* * * * * php artisan schedule:run) pour la purge RGPD de chaque nuit.
APP_NAME="Run For Lorène"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rfl
DB_USERNAME=root
DB_PASSWORD=

# Sessions en base, chiffrées (elles contiennent l'état du tunnel et de l'admin).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (HTTPS)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails : « log » en local (écrits dans storage/logs). En production, SMTP Brevo :
# MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, identifiants SMTP du compte
# Brevo, et une adresse d'expédition validée dans Brevo (domaine de l'association).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@exemple.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiement — clés Stripe (mode test en local : sk_test_…, pk_test_…).
# Webhook local : stripe listen --forward-to localhost:8000/stripe/webhook (donne le whsec_…).
# Sans STRIPE_SECRET, le paiement passe par une page de simulation (APP_ENV=local uniquement).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# PAIEMENT_PASSERELLE=stripe|simulation

# Codes de vérification (OTP) : en local, le code est aussi écrit dans storage/logs/laravel.log
# (jamais en production, même si la variable vaut true).
OTP_DANS_LES_LOGS=true

# Options (t-shirt et tailles) : masquées dans l'admin tant que l'étape Options du tunnel n'existe pas.
OPTIONS_ACTIVES=false

# Back-office : durée (en heures) avant de redemander un code email à l'entrée de l'admin.
ADMIN_CONFIRMATION_HEURES=8

# Proxy devant le site (hébergeur, CDN) : ses adresses séparées par des virgules, ou « * ».
# Sans lui, derrière un proxy, toutes les requêtes auraient la même IP (limites de connexion communes).
TRUSTED_PROXIES=
